Options -Indexes
RewriteEngine On

# Absolute HTTPS targets also work when Timeweb terminates TLS before Apache.
RewriteCond %{HTTP_HOST} ^(?:www\.)?iripurtova-languages\.ru$ [NC]
RewriteRule ^(?:index\.html)?$ https://iripurtova-languages.ru/ru/ [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?iripurtova-languages\.com$ [NC]
RewriteRule ^(?:index\.html)?$ https://iripurtova-languages.com/en/ [R=301,L,NE]

# Do not redirect internal DirectoryIndex subrequests.
RewriteCond %{HTTP_HOST} ^(?:www\.)?iripurtova-languages\.(?:ru|com)$ [NC]
RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.html(?:[?\s]) [NC]
RewriteRule ^ru/(privacy/)?index\.html$ https://iripurtova-languages.ru/ru/$1 [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^(?:www\.)?iripurtova-languages\.(?:ru|com)$ [NC]
RewriteCond %{THE_REQUEST} \s/+[^?\s]*index\.html(?:[?\s]) [NC]
RewriteRule ^(en|fr)/(privacy/)?index\.html$ https://iripurtova-languages.com/$1/$2 [R=301,L,NE]

# Normalize page slashes before mod_dir can produce a backend HTTP URL.
RewriteCond %{HTTP_HOST} ^(?:www\.)?iripurtova-languages\.(?:ru|com)$ [NC]
RewriteRule ^ru$ https://iripurtova-languages.ru/ru/ [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^(?:www\.)?iripurtova-languages\.(?:ru|com)$ [NC]
RewriteRule ^ru/privacy$ https://iripurtova-languages.ru/ru/privacy/ [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^(?:www\.)?iripurtova-languages\.(?:ru|com)$ [NC]
RewriteRule ^(en|fr)$ https://iripurtova-languages.com/$1/ [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^(?:www\.)?iripurtova-languages\.(?:ru|com)$ [NC]
RewriteRule ^(en|fr)/privacy$ https://iripurtova-languages.com/$1/privacy/ [R=301,L,NE]

# One canonical domain per language; existing query strings are preserved.
RewriteCond %{HTTP_HOST} ^(?:www\.)?iripurtova-languages\.com$ [NC]
RewriteRule ^ru/(.*)$ https://iripurtova-languages.ru/ru/$1 [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^(?:www\.)?iripurtova-languages\.ru$ [NC]
RewriteRule ^(en|fr)/(.*)$ https://iripurtova-languages.com/$1/$2 [R=301,L,NE]

RewriteCond %{HTTP_HOST} ^www\.iripurtova-languages\.ru$ [NC]
RewriteRule ^ https://iripurtova-languages.ru%{REQUEST_URI} [R=301,L,NE]
RewriteCond %{HTTP_HOST} ^www\.iripurtova-languages\.com$ [NC]
RewriteRule ^ https://iripurtova-languages.com%{REQUEST_URI} [R=301,L,NE]

# Shared public_html, separate robots/sitemap for each canonical domain.
RewriteCond %{HTTP_HOST} ^iripurtova-languages\.ru$ [NC]
RewriteRule ^robots\.txt$ robots-ru.txt [L]
RewriteCond %{HTTP_HOST} ^iripurtova-languages\.ru$ [NC]
RewriteRule ^sitemap\.xml$ sitemap-ru.xml [L]
