# Public counter ID. Empty ID also disables analytics.
VITE_YANDEX_METRIKA_ID=113677290
# Owner-approved activation. Visitor consent is still required before loading.
# Set false to disable collection regardless of the saved consent.
VITE_YANDEX_METRIKA_ENABLED=true

# One MyTracker counter on .ru and .com, using the COM CDN after consent.
VITE_MYTRACKER_ID=3808064
VITE_MYTRACKER_ENABLED=true
